tag: bigbench_generate_until
dataset_path: hails/bigbench
output_type: generate_until
dataset_kwargs:
  # num_shots: 0 # TODO: num of shots for `bigbench` HF dataset should be controlled through this, not through the typical methods
  # subtask_name: null
test_split: default
doc_to_text: >
  Solve the following problem. Only write the final answer, without explanation or reasoning.
  {{inputs}}
doc_to_target: "{{targets[0]}}"
generation_kwargs:
  max_gen_toks: 128
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
    ignore_punctuation: true
  - metric: bleu_corpus
    aggregation: bleu_corpus
    higher_is_better: true
    ignore_punctuation: true
  - metric: bleu_sentence
    aggregation: bleu_sentence
    higher_is_better: true
    ignore_punctuation: true
  - metric: rouge1
    aggregation: rouge1
    higher_is_better: true
    ignore_punctuation: true
  - metric: rouge2
    aggregation: rouge2
    higher_is_better: true
    ignore_punctuation: true
  - metric: rougeL
    aggregation: rougeL
    higher_is_better: true
    ignore_punctuation: true
  - metric: fuzzy_match
    aggregation: fuzzy_match
    higher_is_better: true
  - metric: bertscore
    aggregation: bertscore
    higher_is_better: true
metadata:
  version: 1.0